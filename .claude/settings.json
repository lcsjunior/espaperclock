{
	"permissions": {
		"allow": [
			"mcp__context7__query-docs",
			"mcp__context7__resolve-library-id"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "f=$(jq -r '.tool_input.file_path // empty'); [[ \"$f\" =~ \\.(cpp|h|hpp|ino)$ ]] && clang-format -i \"$f\" || true",
						"statusMessage": "Formatting C++..."
					}
				]
			}
		]
	}
}